"VertexLitGeneric"
{
	"$halflambert" "1"				
	"$nocull" 1
	"$model" 1
	"$alpha" 0

	"$phong" "1"						

	$phongboost                 		"0"
	$phongfresnelranges         		"[0.1 0.1 0.1]"
	"$phongalbedotint" 			"1"	

	$envmap 				env_cubemap
	$normalmapalphaenvmapmask 1	
	$envmapfresnel 			1
	$envmapFresnelMinMaxExp 		"[.05 .1 .1]"
	$envmaptint 			"[0.01 0.01 0.01]"

	$color2				"[0.9 0.9 0.9]"	


////////////////////////////////////////////////////////////////////////////////////////////////
// REAL RNG : MODEL (2016)
////////////////////////////////////////////////////////////////////////////////////////////////

	$objnumber 4.99 // MODIFY ONLY THIS IN THIS VMT
	$objlimit	4.49 // MODIFY ONLY THIS IN THIS VMT
	$selected 1000
	$rand 1000

	$one 1
	$zero 0
	$pf "0.5"

	$itemtocheck 0
	$itemtocheckr 0


"Proxies"
{

	"EntityRandom"
	{
	"scale" "$objnumber" 
	"resultVar" "$rand"
	}


	"LessOrEqual" 
      	  {
          	  "LessEqualVar" "$rand"
          	  "greaterVar" "$objlimit"
          	  "srcVar1" "$rand"
           	  "srcVar2" "$objlimit"          
          	  "resultVar" "$selected"    
       	 }

	"Subtract"
      	  {
          	  "srcVar1" "$selected"
           	  "srcVar2" "$itemid"          
          	  "resultVar" "$itemtocheck"    
       	 }
	
	"Abs" 
      	  {
          	  "srcVar1" "$itemtocheck"          
          	  "resultVar" "$itemtocheckr"    
       	 }

	"LessOrEqual" 
      	  {
          	  "LessEqualVar" "$one"
          	  "greaterVar" "$zero"
          	  "srcVar1" "$itemtocheckr"
           	  "srcVar2" "$pf"          
          	  "resultVar" "$alpha"    
       	 }

}



}





